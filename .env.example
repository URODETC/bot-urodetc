# Bot
BOT_TOKEN=1234567890:AA...your-telegram-bot-token
LOG_LEVEL=INFO

# Database: SQLite (default) or PostgreSQL for production
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot

# Redis / ARQ queue
# REDIS_URL=redis://localhost:6379/0

# Where media files are downloaded before being sent
# DOWNLOAD_DIR=./data/downloads

# Netscape-format cookies file (exported from your browser) used by yt-dlp
# as a fallback when PO tokens are not configured or YouTube still asks to
# confirm you're not a bot. Optional.
# COOKIES_FILE=/srv/cookies.txt

# PO tokens (Proof of Origin) — primary bypass for YouTube's "Sign in to
# confirm you're not a bot".
# The yt-dlp plugin `bgutil-ytdlp-pot-provider` is installed as a regular
# Python dependency (see pyproject.toml). It obtains PO tokens from the
# `potoken` service (bgutil HTTP server, port 4416) defined in
# docker-compose.yml; set its base URL here:
POTOKEN_HTTP_URL=http://potoken:4416
# For a local run without Docker, start the bgutil server yourself
# (node build/main.js --port 4416) and yt-dlp will reach it via the
# default http://127.0.0.1:4416, so POTOKEN_HTTP_URL can stay unset.
# Cookies (cookies.txt) remain the fallback if tokens don't help.

# Local Bot API Server (enables up to 2 GB files), e.g.:
# LOCAL_API_BASE=http://localhost:8081
# Leave empty to use the default 50 MB limit.

# Hard override of the max upload size in MB (optional)
# MAX_FILE_SIZE_MB=100

# Telegram IDs allowed to manage sensitive owner-only tools.
# Keep this set: VPN management is denied to everyone when it is empty.
OWNER_TELEGRAM_IDS=123456789

# Remnawave panel (official REST API). Supported API majors: 2 and 3.
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=replace-with-panel-api-token
REMNAWAVE_API_MAJOR=3
# Optional API key when the panel is behind Caddy Security.
# REMNAWAVE_CADDY_TOKEN=

# Defaults for /vpn_add. A traffic limit of 0 means unlimited.
REMNAWAVE_DEFAULT_DURATION_DAYS=30
REMNAWAVE_DEFAULT_TRAFFIC_GB=0
# New users need at least one Internal Squad to receive VPN configs.
REMNAWAVE_DEFAULT_SQUAD_UUIDS=00000000-0000-0000-0000-000000000000

# Weekly report: Monday 09:00 Europe/Moscow by default.
# If chat IDs are omitted, reports are sent to OWNER_TELEGRAM_IDS.
# REMNAWAVE_REPORT_CHAT_IDS=123456789,-1001234567890
REMNAWAVE_REPORT_WEEKDAY=mon
REMNAWAVE_REPORT_HOUR=9
REMNAWAVE_REPORT_MINUTE=0
REMNAWAVE_REPORT_TIMEZONE=Europe/Moscow
REMNAWAVE_REPORT_TOP_USERS=20

# Films / series: direct RuTracker access and existing qBittorrent WebUI.
# Configure the same values for bot and worker. OWNER_TELEGRAM_IDS is required.
RUTRACKER_URL=https://rutracker.org
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=
# Optional bb_session cookie value from an authenticated browser session.
# Use it if login requires CAPTCHA; refresh and restart worker when it expires.
RUTRACKER_SESSION=
QBITTORRENT_URL=http://your-qbittorrent-host:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Path as seen by qBittorrent (not by the bot container).
QBITTORRENT_SAVE_PATH=/downloads/cinema
QBITTORRENT_CATEGORY=cinema

# Optional per-service HTTP proxies (Hysteria client inside Docker).
# TELEGRAM_PROXY_URL=http://hysteria:8080
# RUTRACKER_PROXY_URL=http://hysteria:8080
