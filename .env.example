# Bot
BOT_TOKEN=1234567890:AA...your-telegram-bot-token
LOG_LEVEL=INFO

# Database: SQLite (default) or PostgreSQL for production
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot

# Redis / ARQ queue
# REDIS_URL=redis://localhost:6379/0

# Where media files are downloaded before being sent
# DOWNLOAD_DIR=./data/downloads

# Netscape-format cookies file (exported from your browser) used by yt-dlp
# as a fallback when PO tokens are not configured or YouTube still asks to
# confirm you're not a bot. Optional.
# COOKIES_FILE=/srv/cookies.txt

# PO tokens (Proof of Origin) — primary bypass for YouTube's "Sign in to
# confirm you're not a bot".
# The yt-dlp plugin `bgutil-ytdlp-pot-provider` is installed as a regular
# Python dependency (see pyproject.toml). It obtains PO tokens from the
# `potoken` service (bgutil HTTP server, port 4416) defined in
# docker-compose.yml; set its base URL here:
POTOKEN_HTTP_URL=http://potoken:4416
# For a local run without Docker, start the bgutil server yourself
# (node build/main.js --port 4416) and yt-dlp will reach it via the
# default http://127.0.0.1:4416, so POTOKEN_HTTP_URL can stay unset.
# Cookies (cookies.txt) remain the fallback if tokens don't help.

# Local Bot API Server (enables up to 2 GB files), e.g.:
# LOCAL_API_BASE=http://localhost:8081
# Leave empty to use the default 50 MB limit.

# Hard override of the max upload size in MB (optional)
# MAX_FILE_SIZE_MB=100